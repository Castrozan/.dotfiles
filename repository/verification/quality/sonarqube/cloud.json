{
  "organization": "castrozan-oss",
  "project": "Castrozan_.dotfiles",
  "repository": "Castrozan/.dotfiles",
  "mainBranch": "main",
  "newCodeDays": 30,
  "qualityGate": {
    "name": "Dotfiles",
    "conditions": [
      {
        "metric": "new_violations",
        "op": "GT",
        "error": "0"
      },
      {
        "metric": "new_coverage",
        "op": "LT",
        "error": "65"
      },
      {
        "metric": "new_duplicated_lines_density",
        "op": "GT",
        "error": "3"
      },
      {
        "metric": "new_security_hotspots_reviewed",
        "op": "LT",
        "error": "100"
      }
    ]
  },
  "qualityProfiles": [
    {
      "language": "py",
      "name": "Dotfiles",
      "parent": "Sonar way comprehensive",
      "rules": [
        {
          "key": "python:S104",
          "parameters": {
            "maximum": "200"
          }
        }
      ]
    },
    {
      "language": "js",
      "name": "Dotfiles",
      "parent": "Sonar way comprehensive",
      "rules": [
        {
          "key": "javascript:S104",
          "parameters": {
            "maximum": "200"
          }
        }
      ]
    },
    {
      "language": "ts",
      "name": "Dotfiles",
      "parent": "Sonar way comprehensive",
      "rules": [
        {
          "key": "typescript:S104",
          "parameters": {
            "maximum": "200"
          }
        }
      ]
    },
    {
      "language": "shell",
      "name": "Dotfiles",
      "parent": "Sonar way comprehensive",
      "rules": []
    }
  ],
  "settings": {
    "sonar.leak.period": "30",
    "sonar.qualitygate.ignoreSmallChanges": "false"
  }
}
