+++ b/hooks/core/held-store-lock.ts	2026-11-16 12:36:31
@@ -0,0 +1,15 @@
+import { errorText } from './text'
+
+const heldStoreLock = /Lock file is already being held/
+const heldStoreLockBackoffMilliseconds = [25, 50, 100, 200, 400, 800, 1600]
+
+export async function retryingHeldStoreLock<T>(write: () => Promise<T>, sleep: (milliseconds: number) => Promise<unknown>): Promise<T> {
+  for (const delay of heldStoreLockBackoffMilliseconds) {
+    try { return await write() }
+    catch (error) {
+      if (!heldStoreLock.test(errorText(error))) throw error
+      await sleep(delay)
+    }
+  }
+  return write()
+}
