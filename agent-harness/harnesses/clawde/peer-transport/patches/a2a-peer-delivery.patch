+
+    def submit_notification(
+        self, peer_name: str, request_body_bytes: bytes
+    ) -> tuple[int, str, bytes]:
+        session = self._registry.session_named(peer_name)
+        if session is None:
+            return self._unknown_agent_response(peer_name)
+        if len(request_body_bytes) > MAXIMUM_NOTIFICATION_REQUEST_BYTES:
+            return json_response(413, {"error": "notification_request_too_large"})
+        try:
+            body = json.loads(request_body_bytes.decode("utf-8"))
+        except (json.JSONDecodeError, UnicodeDecodeError):
+            return json_response(400, {"error": "invalid_json"})
+        if not isinstance(body, dict):
+            return json_response(400, {"error": "invalid_notification"})
+        claimed_sender = body.get("claimedSender")
+        content = body.get("content")
+        if not isinstance(claimed_sender, str) or not claimed_sender:
+            return json_response(400, {"error": "missing_claimed_sender"})
+        if not isinstance(content, str) or not content:
+            return json_response(400, {"error": "missing_content"})
+        notification = session.notification_mailbox.publish(
+            PeerNotificationInput(claimed_sender, content)
+        )
+        if notification is None:
+            return json_response(429, {"error": "notification_mailbox_full"})
+        return json_response(202, notification.to_json_serializable_dict())
+
+    def read_notifications(self, peer_name: str) -> tuple[int, str, bytes]:
+        session = self._registry.session_named(peer_name)
+        if session is None:
+            return self._unknown_agent_response(peer_name)
+        return json_response(
+            200,
+            {
+                "recipientPaneId": session.pane_id,
+                "messages": [
+                    notification.to_json_serializable_dict()
+                    for notification in session.notification_mailbox.read()
+                ],
+            },
+        )
+
+    def acknowledge_notification(
+        self, peer_name: str, notification_identifier: str
+    ) -> tuple[int, str, bytes]:
+        session = self._registry.session_named(peer_name)
+        if session is None:
+            return self._unknown_agent_response(peer_name)
+        session.notification_mailbox.acknowledge(notification_identifier)
+        return json_response(
+            200,
+            {
+                "id": notification_identifier,
+                "recipientPaneId": session.pane_id,
+                "acknowledged": True,
+            },
+        )
