+type ReplyRender = Frozen<MatchedEvent<'ui.render', { component: 'AssistantMessage' }>>
+
+async function replyTree($: EngineInterface, e: ReplyRender): Promise<RenderElement | undefined> {
+  if (e.props.text.length > MAX_TEXT) return undefined
+  const ctx = await contextFor($, $.ui.resolve(e), e.viewport?.columns)
+  if (ctx === undefined) return undefined
+  const text = restoreLines(e.props.text, await read($, written))
+  const { Box, Text } = ctx.t
+  return (
+    <Box flexDirection="row" marginTop={1}>
+      <Box width={2} flexShrink={0}>
+        <Text color={ctx.p.dot}>{e.props.isFirstOfReply ? '⏺' : ' '}</Text>
+      </Box>
+      <Box flexDirection="column" flexGrow={1} flexShrink={1}>
+        {blocks(parse(text), { ...ctx, width: ctx.width - 2 })}
+      </Box>
+    </Box>
+  )
+}
