#!/usr/bin/env bash

unset ANTHROPIC_API_KEY
exec "$CLAUDE_GO_LAUNCHER_LIFECYCLE_PYTHON" \
	"$CLAUDE_GO_LAUNCHER_LIFECYCLE_SCRIPT" \
	--registry-directory "$CLAUDE_GO_LAUNCHER_PROXY_REGISTRY_DIRECTORY" \
	--listen-address "$CLAUDE_GO_LAUNCHER_PROXY_LISTEN_ADDRESS" \
	--listen-port "$CLAUDE_GO_LAUNCHER_PROXY_LISTEN_PORT" \
	--service-controller "$CLAUDE_GO_LAUNCHER_PROXY_SERVICE_CONTROLLER" \
	--service-label "$CLAUDE_GO_LAUNCHER_PROXY_SERVICE_LABEL" \
	--startup-timeout-seconds "$CLAUDE_GO_LAUNCHER_PROXY_STARTUP_TIMEOUT_SECONDS" \
	--unavailable-message "${CLAUDE_GO_LAUNCHER_PROXY_UNAVAILABLE_MESSAGE//@CURRENT_USER_ID@/$(id -u)}" \
	-- "$CLAUDE_GO_LAUNCHER_CLAUDE_BINARY" --model "$CLAUDE_GO_LAUNCHER_MODEL" "$@"
