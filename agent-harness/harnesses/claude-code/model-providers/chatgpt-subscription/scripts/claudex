#!/usr/bin/env bash

unset ANTHROPIC_API_KEY
currentUserId="$(id -u)"
exec "$CLAUDEX_LAUNCHER_LIFECYCLE_PYTHON" \
	"$CLAUDEX_LAUNCHER_LIFECYCLE_SCRIPT" \
	--registry-directory "$CLAUDEX_LAUNCHER_PROXY_REGISTRY_DIRECTORY" \
	--listen-address "$CLAUDEX_LAUNCHER_PROXY_LISTEN_ADDRESS" \
	--listen-port "$CLAUDEX_LAUNCHER_PROXY_LISTEN_PORT" \
	--start-command "${CLAUDEX_LAUNCHER_PROXY_START_COMMAND//@CURRENT_USER_ID@/$currentUserId}" \
	--stop-command "${CLAUDEX_LAUNCHER_PROXY_STOP_COMMAND//@CURRENT_USER_ID@/$currentUserId}" \
	--startup-timeout-seconds "$CLAUDEX_LAUNCHER_PROXY_STARTUP_TIMEOUT_SECONDS" \
	--unavailable-message "${CLAUDEX_LAUNCHER_PROXY_UNAVAILABLE_MESSAGE//@CURRENT_USER_ID@/$currentUserId}" \
	-- "$CLAUDEX_LAUNCHER_CLAUDE_BINARY" --model "$CLAUDEX_LAUNCHER_MODEL" "$@"
