#!/usr/bin/env bash

interactivePreferencesArguments=()
codexLaunchExecutable="$CODEX_LAUNCHER_BINARY"
unset CODEX_SESSION_SOCKET_PATH
case "$#:${1:-}" in
1:--help | 1:-h | 1:--version | 1:-V) exec "$CODEX_LAUNCHER_BINARY" "$@" ;;
esac
codexCommand=""
codexCommandOptionValuePending=false
for argument in "$@"; do
	if [[ "$codexCommandOptionValuePending" = true ]]; then
		codexCommandOptionValuePending=false
		continue
	fi
	case "$argument" in
	--) break ;;
	-C | --cd | -c | --config | --enable | --disable | -p | --profile | -m | --model | -i | --image | -s | --sandbox | -a | --ask-for-approval | --add-dir | --local-provider | --remote | --remote-auth-token-env | --code-mode-host)
		codexCommandOptionValuePending=true
		;;
	-*) ;;
	*)
		codexCommand="$argument"
		break
		;;
	esac
done
case "$codexCommand" in
agents | exec | e | review | login | logout | mcp | plugin | app-server | remote-control | app | completion | update | doctor | sandbox | debug | apply | a | queue | archive | delete | migrate-rollouts | unarchive | cloud | exec-server | features | help) ;;
*)
	export AGENT_INTERACTIVE_PREFERENCES_PATH="$CODEX_LAUNCHER_DEVELOPER_INSTRUCTIONS_FILE"
	interactivePreferencesArguments=(--profile dotfiles-interactive)
	codexLaunchExecutable="$CODEX_LAUNCHER_SESSION_EXECUTABLE"
	for argument in "$@"; do
		case "$argument" in
		--) break ;;
		--no-daemon | --remote | --remote=* | --help | -h | --version | -V)
			codexLaunchExecutable="$CODEX_LAUNCHER_BINARY"
			;;
		-p | -p?* | --profile | --profile=*) interactivePreferencesArguments=() ;;
		esac
	done
	;;
esac
if [[ "$codexLaunchExecutable" == "$CODEX_LAUNCHER_BINARY" ]]; then
	"$CODEX_LAUNCHER_HOOK_TRUST_EXECUTABLE" "$@" || exit "$?"
fi
exec "$codexLaunchExecutable" \
	--config 'default_permissions=":danger-full-access"' \
	--ask-for-approval "never" \
	"${interactivePreferencesArguments[@]}" \
	"$@"
