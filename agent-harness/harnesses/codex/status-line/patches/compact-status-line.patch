diff --git a/tui/src/bottom_pane/status_line_layout.rs b/tui/src/bottom_pane/status_line_layout.rs
--- /dev/null
+++ b/tui/src/bottom_pane/status_line_layout.rs
@@ -0,0 +1,66 @@
+use codex_protocol::ThreadId;
+use ratatui::text::Line;
+use ratatui::text::Span;
+
+use super::status_line_setup::StatusLineItem;
+use crate::line_truncation::truncate_line_with_ellipsis_if_overflow;
+
+pub(super) fn compact_status_line_value(item: StatusLineItem, text: String) -> String {
+    match item {
+        StatusLineItem::ContextUsed => text.trim_end_matches(" used").to_string(),
+        StatusLineItem::WeeklyLimit => {
+            let value = text.trim_end_matches(" left");
+            value.strip_prefix("weekly ").map_or_else(
+                || value.to_string(),
+                |percentage| format!("Week {percentage}"),
+            )
+        }
+        StatusLineItem::ThreadName | StatusLineItem::ThreadTitle => {
+            if ThreadId::from_string(&text).is_ok() {
+                return text;
+            }
+            let (prefix, title) = text
+                .split_once(" | ")
+                .map_or((String::new(), text.as_str()), |(prefix, title)| {
+                    (format!("{prefix} | "), title)
+                });
+            let mut words = title.split_whitespace();
+            let mut title = words.by_ref().take(3).collect::<Vec<_>>().join(" ");
+            if words.next().is_some() {
+                title.push('…');
+            }
+            let title = truncate_line_with_ellipsis_if_overflow(Line::from(title), 24);
+            format!("{prefix}{title}")
+        }
+        _ => text,
+    }
+}
+
+pub(super) fn fit_status_line_to_width(mut line: Line<'static>, width: usize) -> Line<'static> {
+    if line.width() <= width {
+        return line;
+    }
+    let Some(identifier_position) = line
+        .spans
+        .iter()
+        .rposition(|span| ThreadId::from_string(span.content.as_ref()).is_ok())
+    else {
+        return truncate_line_with_ellipsis_if_overflow(line, width);
+    };
+    let identifier = line.spans[identifier_position].clone();
+    line.spans.truncate(identifier_position);
+    let separator = line.spans.pop().unwrap_or_else(|| Span::raw(" · "));
+    if line.spans.is_empty() || width <= identifier.width() + separator.width() + 1 {
+        return truncate_line_with_ellipsis_if_overflow(Line::from(identifier), width);
+    }
+    let mut line = truncate_line_with_ellipsis_if_overflow(
+        line,
+        width - identifier.width() - separator.width(),
+    );
+    line.spans.extend([separator, identifier]);
+    line
+}
+
+#[cfg(test)]
+#[path = "status_line_layout_tests.rs"]
+mod tests;
