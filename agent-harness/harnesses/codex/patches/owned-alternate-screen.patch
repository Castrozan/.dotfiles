+
+    assert!(session.release(&mut commands).is_err());
+    assert!(session.is_active());
+    assert_effects(&commands, LEAVE);
+
+    commands.effects.clear();
+    session.release(&mut commands).expect("retry release");
+    assert!(!session.is_active());
+    assert_effects(&commands, LEAVE);
+}
