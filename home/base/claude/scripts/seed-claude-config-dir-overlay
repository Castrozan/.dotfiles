#!/usr/bin/env python3
import argparse
import json
import os
import shutil
import sys
from pathlib import Path

ENTRIES_KEPT_ISOLATED_FROM_SHARED_CONFIG = {"plugins", "settings.json"}
RUNTIME_OWNED_SETTINGS_KEYS_PRESERVED_ACROSS_LAUNCHES = {
    "theme",
    "voice",
    "voiceEnabled",
    "extraKnownMarketplaces",
}


def read_json_object_or_none(json_path):
    try:
        parsed = json.loads(json_path.read_text())
    except (OSError, ValueError):
        return None
    return parsed if isinstance(parsed, dict) else None


def write_json_object_as_owner_readable_file(json_path, json_object):
    temporary_path = json_path.with_name(f"{json_path.name}.tmp.{os.getpid()}")
    temporary_path.write_text(json.dumps(json_object, indent=2))
    temporary_path.chmod(0o600)
    os.replace(temporary_path, json_path)


def deep_merge_overlay_onto_base(base_value, overlay_value):
    if isinstance(base_value, dict) and isinstance(overlay_value, dict):
        merged = dict(base_value)
        for overlay_key, overlay_child in overlay_value.items():
            if overlay_key in merged:
                merged[overlay_key] = deep_merge_overlay_onto_base(
                    merged[overlay_key], overlay_child
                )
            else:
                merged[overlay_key] = overlay_child
        return merged
    return overlay_value


def ensure_symlink_pointing_at(link_path, intended_target):
    if link_path.is_symlink():
        if os.readlink(link_path) == str(intended_target):
            return
        link_path.unlink()
    elif link_path.exists():
        if link_path.is_dir():
            shutil.rmtree(link_path)
        else:
            link_path.unlink()
    link_path.symlink_to(intended_target)


def mirror_shared_config_entries_as_symlinks(
    source_config_directory, target_config_directory
):
    for source_entry in source_config_directory.iterdir():
        if source_entry.name in ENTRIES_KEPT_ISOLATED_FROM_SHARED_CONFIG:
            continue
        ensure_symlink_pointing_at(
            target_config_directory / source_entry.name, source_entry
        )


def rebuild_isolated_settings_from_shared_settings_and_overlay(
    source_config_directory, target_config_directory, settings_overlay_file
):
    shared_settings_path = source_config_directory / "settings.json"
    shared_settings = read_json_object_or_none(shared_settings_path)
    if shared_settings is None:
        if shared_settings_path.exists():
            return
        shared_settings = {}

    target_settings_path = target_config_directory / "settings.json"
    isolated_settings = read_json_object_or_none(target_settings_path)
    runtime_owned_settings = {
        key: value
        for key, value in (isolated_settings or {}).items()
        if key in RUNTIME_OWNED_SETTINGS_KEYS_PRESERVED_ACROSS_LAUNCHES
    }
    settings_overlay = json.loads(Path(settings_overlay_file).read_text())
    rebuilt_settings = deep_merge_overlay_onto_base(
        deep_merge_overlay_onto_base(shared_settings, runtime_owned_settings),
        settings_overlay,
    )
    if rebuilt_settings == isolated_settings:
        return
    write_json_object_as_owner_readable_file(target_settings_path, rebuilt_settings)


def seed_isolated_claude_json_once(source_config_directory, target_config_directory):
    target_claude_json_path = target_config_directory / ".claude.json"
    if target_claude_json_path.exists():
        return
    shared_claude_json_path = source_config_directory.parent / ".claude.json"
    if shared_claude_json_path.exists():
        shutil.copyfile(shared_claude_json_path, target_claude_json_path)
    else:
        target_claude_json_path.write_text(json.dumps({"installMethod": "native"}))
    target_claude_json_path.chmod(0o600)


def refresh_isolated_mcp_servers_from_shared_claude_json(
    source_config_directory, target_config_directory
):
    shared_claude_json = (
        read_json_object_or_none(source_config_directory.parent / ".claude.json") or {}
    )
    shared_mcp_servers = shared_claude_json.get("mcpServers")
    if not isinstance(shared_mcp_servers, dict):
        return
    target_claude_json_path = target_config_directory / ".claude.json"
    isolated_claude_json = read_json_object_or_none(target_claude_json_path)
    if isolated_claude_json is None:
        return
    isolated_mcp_servers = isolated_claude_json.get("mcpServers")
    merged_mcp_servers = {
        **(isolated_mcp_servers if isinstance(isolated_mcp_servers, dict) else {}),
        **shared_mcp_servers,
    }
    if merged_mcp_servers == isolated_mcp_servers:
        return
    isolated_claude_json["mcpServers"] = merged_mcp_servers
    write_json_object_as_owner_readable_file(
        target_claude_json_path, isolated_claude_json
    )


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--source-config-directory", required=True)
    parser.add_argument("--target-config-directory", required=True)
    parser.add_argument("--settings-overlay-file", required=True)
    arguments = parser.parse_args()

    source_config_directory = Path(arguments.source_config_directory)
    target_config_directory = Path(arguments.target_config_directory)

    if not source_config_directory.is_dir():
        print(
            f"source config directory {source_config_directory} does not exist",
            file=sys.stderr,
        )
        return 1

    target_config_directory.mkdir(parents=True, exist_ok=True)
    (target_config_directory / "plugins").mkdir(exist_ok=True)

    mirror_shared_config_entries_as_symlinks(
        source_config_directory, target_config_directory
    )
    rebuild_isolated_settings_from_shared_settings_and_overlay(
        source_config_directory,
        target_config_directory,
        arguments.settings_overlay_file,
    )
    seed_isolated_claude_json_once(source_config_directory, target_config_directory)
    refresh_isolated_mcp_servers_from_shared_claude_json(
        source_config_directory, target_config_directory
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
