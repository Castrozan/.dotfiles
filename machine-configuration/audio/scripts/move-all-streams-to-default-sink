#!/usr/bin/env bash

default_sink_index=$(pactl list sinks short | awk -v name="$(pactl get-default-sink)" '$2 == name { print $1 }')
[ -z "$default_sink_index" ] && exit 0
virtual_sink_indexes=$(pactl list sinks short | awk '$2 !~ /^(alsa|bluez)_output\./ { print $1 }')
pactl list sink-inputs short | awk -v virtual_sink_indexes="$virtual_sink_indexes" '
	BEGIN { split(virtual_sink_indexes, indexes); for (position in indexes) is_virtual_sink[indexes[position]] = 1 }
	!($2 in is_virtual_sink) { print $1 }
' | while read -r stream_index; do
	pactl move-sink-input "$stream_index" "$default_sink_index" 2>/dev/null || true
done
