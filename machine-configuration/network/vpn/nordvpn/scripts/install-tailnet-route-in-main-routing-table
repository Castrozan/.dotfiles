#!/usr/bin/env bash
set -Eeuo pipefail

readonly TAILNET_ADDRESS_RANGE="100.64.0.0/10"
readonly TAILSCALE_INTERFACE="tailscale0"
readonly INTERFACE_APPEARANCE_ATTEMPTS=60
readonly INTERFACE_APPEARANCE_POLL_SECONDS=1

_wait_for_tailscale_interface() {
	local attempt
	for ((attempt = 0; attempt < INTERFACE_APPEARANCE_ATTEMPTS; attempt++)); do
		if ip link show "$TAILSCALE_INTERFACE" >/dev/null 2>&1; then
			return 0
		fi
		sleep "$INTERFACE_APPEARANCE_POLL_SECONDS"
	done
	return 1
}

_install_tailnet_route_in_main_routing_table() {
	ip route replace "$TAILNET_ADDRESS_RANGE" dev "$TAILSCALE_INTERFACE" table main
}

if ! _wait_for_tailscale_interface; then
	echo "Interface $TAILSCALE_INTERFACE never appeared, tailnet traffic stays exposed to full-tunnel VPN capture" >&2
	exit 1
fi

_install_tailnet_route_in_main_routing_table
