+#[test]
+fn navigator_collapsed_opens_at_current_workspace_and_keeps_it_visible() {
+    let mut config = Config::default();
+    config.ui.navigator_collapse_workspaces = true;
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    for current in [0, 12, 24] {
+        let mut projection = snapshot();
+        projection.workspaces = (0..25)
+            .map(|index| {
+                let mut workspace = projection.workspaces[0].clone();
+                workspace.workspace_id = format!("workspace_{index}");
+                workspace.label = format!("workspace {index}");
+                workspace.number = index + 1;
+                workspace.focused = index == current;
+                workspace
+            })
+            .collect();
+        let workspace_id = format!("workspace_{current}");
+        projection.focused_workspace_id = Some(workspace_id.clone());
+        projection.tabs[0].workspace_id = workspace_id.clone();
+        projection.panes[0].workspace_id = workspace_id.clone();
+        state.set_snapshot(Box::new(projection));
+        state.set_pane_surface(surface());
+        state.record_binding(
+            crate::input::KeybindMatch::Action(crate::input::KeybindAction::OpenNavigator),
+            &mut ClientShellInput::default(),
+        );
+        let ClientShellOverlay::Navigator(navigator) = state.overlay.as_ref().expect("navigator")
+        else {
+            panic!("expected navigator");
+        };
+        let target = ClientNavigatorTarget::Workspace {
+            endpoint_id: state.active_endpoint_id.clone(),
+            workspace_id,
+        };
+        let rows =
+            render::client_navigator_rows(&state.endpoints, &state.active_endpoint_id, navigator);
+        assert_eq!(
+            super::super::aggregate_navigation::selected_navigator_target(&rows, navigator),
+            Some(target.clone())
+        );
+        state.compose(106, 20).expect("navigator frame");
+        assert!(state
+            .hits
+            .navigator_rows
+            .iter()
+            .any(|(_, row)| row == &target));
+    }
+}
+
+#[test]
+fn navigator_expanded_keeps_the_current_pane_selection() {
+    let mut config = Config::default();
+    config.ui.navigator_collapse_workspaces = false;
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(snapshot()));
+    state.open_navigator_overlay();
+    let ClientShellOverlay::Navigator(navigator) = state.overlay.as_ref().expect("navigator")
+    else {
+        panic!("expected navigator");
+    };
+    let rows =
+        render::client_navigator_rows(&state.endpoints, &state.active_endpoint_id, navigator);
+    assert_eq!(
+        super::super::aggregate_navigation::selected_navigator_target(&rows, navigator),
+        Some(ClientNavigatorTarget::Pane {
+            endpoint_id: state.active_endpoint_id.clone(),
+            pane_id: "pane_1".into(),
+        })
+    );
+}
