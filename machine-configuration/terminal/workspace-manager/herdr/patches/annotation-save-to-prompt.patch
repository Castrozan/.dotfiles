+            calls.push(arguments.to_vec());
+            Ok(r#"{"result":{"agent":{"agent":"codex","agent_status":"idle"}}}"#.into())
+        });
+        assert_eq!(result, Ok(()));
+        assert_eq!(calls.len(), 2);
+        assert_eq!(
+            calls.first().expect("read command"),
+            &["agent", "get", "source-pane"]
+        );
+        let paste_command = calls.get(1).expect("paste command");
+        assert_eq!(
+            paste_command.get(..3).expect("command target"),
+            &["pane", "send-text", "source-pane"]
+        );
+        let paste = paste_command.get(3).expect("paste content");
+        assert!(paste.starts_with("\x1b[200~\n"));
+        assert!(paste.ends_with("\n\x1b[201~"));
+        assert!(paste.contains("original selected output"));
+        assert!(paste.contains("my note"));
+    }
