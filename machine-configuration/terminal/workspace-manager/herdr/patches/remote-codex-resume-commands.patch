+fn command_session_start(output: &str, start: usize, prefix: &str) -> Option<usize> {
+    let argument_start = start + prefix.len();
+    if prefix != "codex --remote " {
+        return Some(argument_start);
+    }
+
+    let (endpoint, arguments) = output[argument_start..].split_once(' ')?;
+    if endpoint.is_empty()
+        || endpoint.starts_with('-')
+        || !endpoint
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || b"/:._-@".contains(&byte))
+    {
+        return None;
+    }
