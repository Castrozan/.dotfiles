+use crate::find_resume_command;
+
+const SESSION: &str = "00000000-0000-4000-8000-000000000001";
+
+#[test]
+fn private_codex_disconnect_footer_uses_a_fresh_local_server() {
+    let output = format!(
+        "Disconnected from this task. Any running work continues.\nTo reconnect, run:\n  codex --remote unix:///tmp/codex-session-example/client.sock resume {SESSION}\nStop the current turn: run codex --remote unix:///tmp/codex-session-example/client.sock agents, select this task, and press x.\n$ "
+    );
+    let command = find_resume_command(|_| Ok(output.clone())).unwrap();
+    assert_eq!(command, Some(format!("codex resume {SESSION}")));
+}
+
+#[test]
+fn private_codex_server_and_profile_proxy_use_the_same_local_resume() {
+    for socket in ["server.sock", "client.sock"] {
+        let output =
+            format!("codex --remote unix:///tmp/codex-session-a_b-123/{socket} resume {SESSION}");
+        let command = find_resume_command(|_| Ok(output.clone())).unwrap();
+        assert_eq!(command, Some(format!("codex resume {SESSION}")), "{socket}");
+    }
+}
+
+#[test]
+fn explicit_remote_servers_and_unowned_socket_paths_keep_their_endpoint() {
+    for endpoint in [
+        "ws://codex.example:8080",
+        "wss://codex.example:443",
+        "unix:///run/codex/server.sock",
+        "unix:///tmp/other-session/client.sock",
+        "unix:///tmp/codex-session-example/other.sock",
+        "unix:///tmp/codex-session-example/nested/client.sock",
+        "unix:///tmp/codex-session-/client.sock",
+        "unix:///tmp/codex-session-../client.sock",
+    ] {
+        let output = format!("codex --remote {endpoint} resume {SESSION}");
+        let command = find_resume_command(|_| Ok(output.clone())).unwrap();
+        assert_eq!(command, Some(output), "{endpoint}");
+    }
+}
+
+#[test]
+fn newest_resume_command_is_selected_before_private_socket_normalization() {
+    let private =
+        format!("codex --remote unix:///tmp/codex-session-example/client.sock resume {SESSION}");
+    let remote = format!("codex --remote wss://codex.example:443 resume {SESSION}");
+    for (output, expected) in [
+        (format!("{private}\n{remote}"), remote.clone()),
+        (
+            format!("{remote}\n{private}"),
+            format!("codex resume {SESSION}"),
+        ),
+    ] {
+        let command = find_resume_command(|_| Ok(output.clone())).unwrap();
+        assert_eq!(command, Some(expected));
+    }
+}
