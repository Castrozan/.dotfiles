+pub(crate) fn normalize_private_codex_resume_command(command: &str) -> String {
+    let Some((endpoint, session)) = command
+        .strip_prefix("codex --remote ")
+        .and_then(|arguments| arguments.split_once(" resume "))
+    else {
+        return command.to_owned();
+    };
+    let Some((directory, socket)) = endpoint
+        .strip_prefix("unix:///tmp/codex-session-")
+        .and_then(|path| path.split_once('/'))
+    else {
+        return command.to_owned();
+    };
+    if directory.is_empty()
+        || !directory
+            .bytes()
+            .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
+        || !matches!(socket, "client.sock" | "server.sock")
+    {
+        return command.to_owned();
+    }
+
+    format!("codex resume {session}")
+}
