@@ -0,0 +1,150 @@
+use super::*;
+
+mod copy_mode;
+
+fn selection_annotation_snapshot() -> ClientShellSnapshot {
+    let mut snapshot = snapshot();
+    snapshot.commands.push(crate::protocol::ClientShellCommand {
+        command_id: "annotation-command".into(),
+        binding_label: "prefix+n".into(),
+        binding_labels: vec!["prefix+n".into()],
+        action: crate::protocol::ClientShellCommandAction::PluginAction,
+        description: None,
+    });
+    snapshot
+}
+
+fn selection_annotation_state() -> ClientShellState {
+    let config: Config = toml::from_str("[ui]\nannotation_command = 'prefix+n'\n").unwrap();
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    state.set_snapshot(Box::new(selection_annotation_snapshot()));
+    let mut pane_surface = surface();
+    pane_surface.panes[0].scroll = Some(crate::protocol::PaneSurfaceScrollMetrics {
+        offset_from_bottom: 0,
+        max_offset_from_bottom: 20,
+        viewport_rows: 2,
+    });
+    state.set_pane_surface(pane_surface);
+    state.compose(106, 20).expect("pane frame");
+    state
+}
+
+fn selection_annotation_command(
+    actions: &[ClientShellAction],
+) -> Option<&crate::api::schema::CommandInvokeParams> {
+    actions.iter().find_map(|action| match action {
+        ClientShellAction::Endpoint { request, .. } => match &request.method {
+            crate::api::schema::Method::CommandInvoke(params) => Some(params),
+            _ => None,
+        },
+        _ => None,
+    })
+}
+
+#[test]
+fn selection_annotation_mouse_release_invokes_once_with_original_coordinates() {
+    let mut state = selection_annotation_state();
+    let pane = state.hits.panes[0].clone();
+    for kind in [
+        MouseEventKind::Down(MouseButton::Left),
+        MouseEventKind::Drag(MouseButton::Left),
+    ] {
+        let column = pane.inner_rect.x
+            + if matches!(kind, MouseEventKind::Drag(_)) {
+                2
+            } else {
+                0
+            };
+        let outcome = state.handle_raw_events(vec![RawInputEvent::Mouse(MouseEvent {
+            kind,
+            column,
+            row: pane.inner_rect.y,
+            modifiers: KeyModifiers::empty(),
+        })]);
+        assert!(selection_annotation_command(&outcome.actions).is_none());
+    }
+    let event = MouseEvent {
+        kind: MouseEventKind::Up(MouseButton::Left),
+        column: pane.inner_rect.x + 2,
+        row: pane.inner_rect.y,
+        modifiers: KeyModifiers::empty(),
+    };
+    let outcome = state.handle_raw_events(vec![RawInputEvent::Mouse(event)]);
+    let command = selection_annotation_command(&outcome.actions).expect("annotation command");
+    assert_eq!(outcome.actions.len(), 1);
+    assert_eq!(command.command_id, "annotation-command");
+    assert_eq!(command.pane_id.as_deref(), Some("pane_1"));
+    let selection = command.selection.as_ref().unwrap();
+    assert_eq!(selection.anchor.col, 0);
+    assert_eq!(selection.cursor.col, 2);
+    assert!(selection.content_revision.is_none());
+    assert!(state.selection.is_none());
+    assert!(selection_annotation_command(
+        &state
+            .handle_raw_events(vec![RawInputEvent::Mouse(event)])
+            .actions
+    )
+    .is_none());
+}
+
+#[test]
+fn selection_annotation_double_click_waits_for_release_and_handles_delayed_text() {
+    for release_before_response in [false, true] {
+        let mut state = word_drag_state(true);
+        state.config.annotation_command = Some("prefix+n".into());
+        state.set_snapshot(Box::new(selection_annotation_snapshot()));
+        let initial = start_word_drag(&mut state);
+        if release_before_response {
+            assert!(
+                word_drag_mouse(&mut state, MouseEventKind::Up(MouseButton::Left), 0, 8)
+                    .actions
+                    .is_empty()
+            );
+        }
+        let mut actions = word_row_reply(&mut state, &initial, "alpha bravo charlie");
+        if !release_before_response {
+            assert!(actions.is_empty());
+            actions =
+                word_drag_mouse(&mut state, MouseEventKind::Up(MouseButton::Left), 0, 8).actions;
+        }
+        let command = selection_annotation_command(&actions).expect("annotation command");
+        let selection = command.selection.as_ref().unwrap();
+        assert_eq!(selection.anchor.col, 6);
+        assert_eq!(selection.cursor.col, 10);
+        assert!(
+            word_drag_mouse(&mut state, MouseEventKind::Up(MouseButton::Left), 0, 8)
+                .actions
+                .is_empty()
+        );
+    }
+}
+
+#[test]
+fn selection_annotation_copy_mode_cancel_never_opens_an_editor() {
+    let mut state = selection_annotation_state();
+    assert!(state.enter_copy_mode(&mut ClientShellInput::default()));
+    let mut outcome = ClientShellInput::default();
+    for code in [KeyCode::Char('V'), KeyCode::Esc] {
+        state.route_copy_mode_key(
+            &crate::input::TerminalKey::new(code, KeyModifiers::empty()),
+            &mut outcome,
+        );
+    }
+    assert!(outcome.actions.is_empty());
+    assert!(state.selection.is_none());
+}
+
+#[test]
+fn selection_annotation_missing_plugin_binding_preserves_normal_copy() {
+    let mut state = selection_annotation_state();
+    state.set_snapshot(Box::new(snapshot()));
+    state.selection = Some(crate::selection::Selection::absolute_range(
+        "pane_1".into(),
+        (0, 0),
+        (0, 2),
+    ));
+    let mut outcome = ClientShellInput::default();
+    assert!(!state.request_selection_action(&mut outcome, true));
+    assert!(outcome.actions.is_empty());
+    assert!(state.selection.is_some());
+}
