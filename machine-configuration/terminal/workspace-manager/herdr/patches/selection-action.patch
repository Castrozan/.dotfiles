@@ -0,0 +1,89 @@
+use super::*;
+
+#[test]
+fn selection_annotation_copy_mode_opens_only_on_a() {
+    for select in [KeyCode::Enter, KeyCode::Char('v'), KeyCode::Char('V')] {
+        let mut state = selection_annotation_state();
+        assert!(state.enter_copy_mode(&mut ClientShellInput::default()));
+        for code in [select, KeyCode::Right, KeyCode::Enter] {
+            let outcome = state.handle_raw_events(vec![RawInputEvent::Key(
+                crate::input::TerminalKey::new(code, KeyModifiers::empty()),
+            )]);
+            assert!(outcome.actions.is_empty());
+            assert_eq!(state.mode, ClientShellMode::Copy);
+        }
+        let expected = state.selection.as_ref().unwrap().ordered_cells();
+        let outcome = state.handle_raw_events(vec![RawInputEvent::Key(
+            crate::input::TerminalKey::new(KeyCode::Char('a'), KeyModifiers::empty()),
+        )]);
+        let command = selection_annotation_command(&outcome.actions).expect("annotation command");
+        assert_eq!(command.pane_id.as_deref(), Some("pane_1"));
+        let selection = command.selection.as_ref().unwrap();
+        assert_eq!((selection.anchor.row, selection.anchor.col), expected.0);
+        assert_eq!((selection.cursor.row, selection.cursor.col), expected.1);
+        assert!(state.copy_mode.is_none());
+        assert_eq!(state.mode, ClientShellMode::Terminal);
+    }
+}
+
+#[test]
+fn selection_annotation_copy_mode_y_copies_without_opening_editor() {
+    for select in [KeyCode::Enter, KeyCode::Char('v'), KeyCode::Char('V')] {
+        let mut state = selection_annotation_state();
+        assert!(state.enter_copy_mode(&mut ClientShellInput::default()));
+        for code in [select, KeyCode::Right] {
+            state.handle_raw_events(vec![RawInputEvent::Key(crate::input::TerminalKey::new(
+                code,
+                KeyModifiers::empty(),
+            ))]);
+        }
+        let outcome = state.handle_raw_events(vec![RawInputEvent::Key(
+            crate::input::TerminalKey::new(KeyCode::Char('y'), KeyModifiers::empty()),
+        )]);
+        assert!(selection_annotation_command(&outcome.actions).is_none());
+        assert!(outcome.actions.iter().any(|action| matches!(
+            action,
+            ClientShellAction::Endpoint { request, .. }
+                if matches!(&request.method, crate::api::schema::Method::PaneSelectionRead(_))
+        )));
+        assert_eq!(state.mode, ClientShellMode::Terminal);
+    }
+}
+
+#[test]
+fn selection_annotation_copy_mode_enter_highlights_current_character() {
+    let mut state = selection_annotation_state();
+    assert!(state.enter_copy_mode(&mut ClientShellInput::default()));
+    let outcome = state.handle_raw_events(vec![RawInputEvent::Key(
+        crate::input::TerminalKey::new(KeyCode::Enter, KeyModifiers::empty()),
+    )]);
+    assert!(outcome.actions.is_empty());
+    assert_eq!(state.mode, ClientShellMode::Copy);
+    assert!(state.selection.as_ref().unwrap().is_visible());
+}
+
+#[test]
+fn selection_annotation_copy_mode_a_without_selection_preserves_copy_mode() {
+    let mut state = selection_annotation_state();
+    assert!(state.enter_copy_mode(&mut ClientShellInput::default()));
+    let outcome = state.handle_raw_events(vec![RawInputEvent::Key(
+        crate::input::TerminalKey::new(KeyCode::Char('a'), KeyModifiers::empty()),
+    )]);
+    assert!(outcome.actions.is_empty());
+    assert_eq!(state.mode, ClientShellMode::Copy);
+}
+
+#[test]
+fn selection_annotation_copy_mode_unavailable_action_preserves_selection() {
+    let mut state = selection_annotation_state();
+    state.set_snapshot(Box::new(snapshot()));
+    assert!(state.enter_copy_mode(&mut ClientShellInput::default()));
+    for code in [KeyCode::Enter, KeyCode::Right, KeyCode::Char('a')] {
+        let outcome = state.handle_raw_events(vec![RawInputEvent::Key(
+            crate::input::TerminalKey::new(code, KeyModifiers::empty()),
+        )]);
+        assert!(outcome.actions.is_empty());
+    }
+    assert_eq!(state.mode, ClientShellMode::Copy);
+    assert!(state.selection.as_ref().unwrap().is_visible());
+}
