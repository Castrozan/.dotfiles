diff --git a/src/client/shell/selection_actions.rs b/src/client/shell/selection_actions.rs
new file mode 100644
index 00000000..396db8ff
--- /dev/null
+++ b/src/client/shell/selection_actions.rs
@@ -0,0 +1,77 @@
+use super::*;
+use crate::api::schema::{CommandInvokeParams, Method, PaneSelectionReadParams, PaneTextPoint};
+
+impl ClientShellState {
+    pub(super) fn request_selection_action(
+        &mut self,
+        outcome: &mut ClientShellInput,
+        live: bool,
+    ) -> bool {
+        let Some(binding) = self
+            .config
+            .annotation_command
+            .as_ref()
+            .filter(|binding| !binding.trim().is_empty())
+        else {
+            return false;
+        };
+        let Some(selection) = self
+            .selection
+            .as_ref()
+            .filter(|selection| selection.is_visible())
+        else {
+            return false;
+        };
+        let Some(snapshot) = self.snapshot.as_deref() else {
+            return false;
+        };
+        let Some(command) = snapshot.commands.iter().find(|command| {
+            command.action == crate::protocol::ClientShellCommandAction::PluginAction
+                && command.binding_labels.contains(binding)
+        }) else {
+            return false;
+        };
+        let Some(pane) = snapshot
+            .panes
+            .iter()
+            .find(|pane| pane.pane_id == selection.pane_id)
+        else {
+            return false;
+        };
+        let content_revision = self
+            .pane_surface
+            .as_ref()
+            .and_then(|surface| {
+                surface
+                    .panes
+                    .iter()
+                    .find(|pane| pane.pane_id == selection.pane_id)
+            })
+            .map(|pane| pane.content_revision)
+            .filter(|_| !live);
+        let (anchor, cursor) = selection.ordered_cells();
+        let params = CommandInvokeParams {
+            command_id: command.command_id.clone(),
+            workspace_id: Some(pane.workspace_id.clone()),
+            tab_id: Some(pane.tab_id.clone()),
+            pane_id: Some(pane.pane_id.clone()),
+            selection: Some(PaneSelectionReadParams {
+                pane_id: pane.pane_id.clone(),
+                anchor: PaneTextPoint {
+                    row: anchor.0,
+                    col: anchor.1,
+                },
+                cursor: PaneTextPoint {
+                    row: cursor.0,
+                    col: cursor.1,
+                },
+                content_revision,
+            }),
+        };
+        self.push_endpoint_method_with_kind(
+            Method::CommandInvoke(params),
+            PendingEndpointKind::Generic,
+            outcome,
+        )
+    }
+}
