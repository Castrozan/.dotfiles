+use super::*;
+
+fn retained_annotation_selection_state() -> ClientShellState {
+    let mut state = selection_annotation_state();
+    state.selection = Some(crate::selection::Selection::absolute_range(
+        "pane_1".into(),
+        (0, 0),
+        (0, 2),
+    ));
+    state
+}
+
+#[test]
+fn selection_annotation_mouse_release_copies_and_retains_highlight_until_ctrl_s() {
+    let mut state = selection_annotation_state();
+    for (kind, column) in [
+        (MouseEventKind::Down(MouseButton::Left), 0),
+        (MouseEventKind::Drag(MouseButton::Left), 2),
+    ] {
+        let outcome = word_drag_mouse(&mut state, kind, 0, column);
+        assert!(selection_annotation_command(&outcome.actions).is_none());
+    }
+    let release = word_drag_mouse(&mut state, MouseEventKind::Up(MouseButton::Left), 0, 2);
+    assert!(selection_annotation_command(&release.actions).is_none());
+    let clipboard = word_row_reply(&mut state, &word_read_id(&release.actions), "abc");
+    assert!(
+        matches!(&clipboard[..], [ClientShellAction::ClipboardWrite(bytes)] if bytes == b"abc")
+    );
+    assert!(state.selection.as_ref().unwrap().is_visible());
+    assert!(state.selection.as_ref().unwrap().is_finalized());
+    assert!(
+        word_drag_mouse(&mut state, MouseEventKind::Up(MouseButton::Left), 0, 2)
+            .actions
+            .is_empty()
+    );
+    let outcome = state.handle_input_bytes(b"\x13");
+    let command = selection_annotation_command(&outcome.actions).expect("annotation command");
+    assert_eq!(command.command_id, "annotation-command");
+    assert_eq!(command.pane_id.as_deref(), Some("pane_1"));
+    let selection = command.selection.as_ref().unwrap();
+    assert_eq!(selection.anchor.col, 0);
+    assert_eq!(selection.cursor.col, 2);
+    assert!(selection.content_revision.is_none());
+    assert!(outcome.requests.is_empty());
+    assert!(state.selection.is_none());
+}
+
+#[test]
+fn selection_annotation_double_click_copies_and_retains_delayed_selection() {
+    for release_before_response in [false, true] {
+        let mut state = word_drag_state(true);
+        state.config.annotation_command = Some("prefix+n".into());
+        state.set_snapshot(Box::new(selection_annotation_snapshot()));
+        let initial = start_word_drag(&mut state);
+        if release_before_response {
+            assert!(
+                word_drag_mouse(&mut state, MouseEventKind::Up(MouseButton::Left), 0, 8)
+                    .actions
+                    .is_empty()
+            );
+        }
+        let mut actions = word_row_reply(&mut state, &initial, "alpha bravo charlie");
+        if !release_before_response {
+            assert!(actions.is_empty());
+            actions =
+                word_drag_mouse(&mut state, MouseEventKind::Up(MouseButton::Left), 0, 8).actions;
+        }
+        assert!(selection_annotation_command(&actions).is_none());
+        let clipboard = word_row_reply(&mut state, &word_read_id(&actions), "bravo");
+        assert!(
+            matches!(&clipboard[..], [ClientShellAction::ClipboardWrite(bytes)] if bytes == b"bravo")
+        );
+        assert!(state.selection_highlight_clear_deadline.is_none());
+        state.tick_copy_feedback(std::time::Instant::now() + std::time::Duration::from_secs(10));
+        assert!(state.selection.as_ref().unwrap().is_visible());
+        let outcome = state.handle_input_bytes(b"\x13");
+        let command = selection_annotation_command(&outcome.actions).expect("annotation command");
+        let selection = command.selection.as_ref().unwrap();
+        assert_eq!(selection.anchor.col, 6);
+        assert_eq!(selection.cursor.col, 10);
+        assert!(outcome.requests.is_empty());
+    }
+}
