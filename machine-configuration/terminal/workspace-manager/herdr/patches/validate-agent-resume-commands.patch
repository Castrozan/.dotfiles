+
+fn command_starts_at_token_boundary(output: &str, start: usize) -> bool {
+    start == 0
+        || output.as_bytes()[start - 1].is_ascii_whitespace()
+        || matches!(output.as_bytes()[start - 1], b'`' | b'\'' | b'"')
+}
+
+fn command_ends_at_token_boundary(output: &str, end: usize) -> bool {
+    let remainder = &output[end..];
+    remainder
+        .lines()
+        .next()
+        .unwrap_or_default()
+        .trim()
+        .is_empty()
+        || matches!(remainder.as_bytes().first(), Some(b'`' | b'\'' | b'"'))
+}
+
+fn valid_session_id(prefix: &str, session_id: &str) -> bool {
+    match prefix {
+        "codex resume " | "claude --resume " => valid_uuid(session_id),
+        "opencode -s ses_" => {
+            session_id.len() == 26 && session_id.bytes().all(|byte| byte.is_ascii_alphanumeric())
+        }
+        _ => !session_id.is_empty(),
+    }
+}
+
+fn valid_uuid(session_id: &str) -> bool {
+    session_id.len() == 36
+        && session_id.bytes().enumerate().all(|(index, byte)| {
+            if matches!(index, 8 | 13 | 18 | 23) {
+                byte == b'-'
+            } else {
+                byte.is_ascii_hexdigit()
+            }
+        })
