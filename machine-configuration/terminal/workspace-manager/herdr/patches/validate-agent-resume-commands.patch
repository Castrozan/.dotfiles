+use crate::resume::latest_command;
+
+const CODEX_SESSION: &str = "01a0e833-6882-7611-961d-255462362973";
+const CLAUDE_SESSION: &str = "d191299d-5dd8-449a-b7e7-44765ed87390";
+const OPENCODE_SESSION: &str = "ses_f171c2cd8ffeqeY5w248uZ0Y4V";
+
+#[test]
+fn codex_exit_footer_ignores_picker_hint_and_previous_bad_insertion() {
+    let output = format!(
+        "Token usage: total=173,394 input=144,455 (+ 10,012,288 cached) output=28,939 (reasoning 14,656)\n\
+         To continue this session, run:\n  codex resume {CODEX_SESSION}\n\
+         Or run codex resume and select Add resume keybind to herdr.\n\
+         lucas.zanoni ~/.dotfiles (main)$ codex resume and\n"
+    );
+    let expected = format!("codex resume {CODEX_SESSION}");
+    assert_eq!(latest_command(&output), Some(expected.as_str()));
+}
+
+#[test]
+fn every_supported_harness_ignores_trailing_help_prose() {
+    for (prefix, session) in [
+        ("codex resume ", CODEX_SESSION),
+        ("claude --resume ", CLAUDE_SESSION),
+        ("opencode -s ", OPENCODE_SESSION),
+        ("droid --resume ", "droid-session-123"),
+    ] {
+        let expected = format!("{prefix}{session}");
+        let output = format!(
+            "Resume this session with:\n{expected}\nOr run {prefix}and select a session.\n"
+        );
+        assert_eq!(latest_command(&output), Some(expected.as_str()), "{prefix}");
+    }
+}
+
+#[test]
+fn uuid_harnesses_reject_words_flags_and_malformed_session_ids() {
+    for prefix in ["codex resume ", "claude --resume "] {
+        for session in [
+            "and",
+            "latest",
+            "--last",
+            "session-id",
+            "019-old",
+            "01a0e833-6882-7611-961d-25546236297g",
+            "01a0e833-6882-7611-961d-255462362973-extra",
+            "01a0e833_6882-7611-961d-255462362973",
+        ] {
+            assert_eq!(
+                latest_command(&format!("{prefix}{session}")),
+                None,
+                "{prefix}{session}"
+            );
+        }
+    }
+}
+
+#[test]
+fn opencode_rejects_empty_placeholder_and_malformed_identifiers() {
+    for session in [
+        "ses_",
+        "ses_and",
+        "ses_ID",
+        "ses_f171c2cd8ffeqeY5w248uZ0Y4V_extra",
+    ] {
+        assert_eq!(
+            latest_command(&format!("opencode -s {session}")),
+            None,
+            "{session}"
+        );
+    }
+}
+
+#[test]
+fn real_claude_and_opencode_exit_footers_keep_the_exact_command() {
+    for output in [
+        format!("Resume this session with:\nclaude --resume {CLAUDE_SESSION}\n$ "),
+        format!(
+            "Session   Terminal resume smoke test\nContinue  opencode -s {OPENCODE_SESSION}\n$ "
+        ),
+    ] {
+        let expected = if output.contains("claude") {
+            format!("claude --resume {CLAUDE_SESSION}")
+        } else {
+            format!("opencode -s {OPENCODE_SESSION}")
+        };
+        assert_eq!(latest_command(&output), Some(expected.as_str()));
+    }
+}
+
+#[test]
+fn newest_valid_command_wins_across_mixed_harnesses() {
+    let commands = [
+        format!("codex resume {CODEX_SESSION}"),
+        format!("claude --resume {CLAUDE_SESSION}"),
+        format!("opencode -s {OPENCODE_SESSION}"),
+        "droid --resume droid-session-123".to_string(),
+    ];
+    for newest in &commands {
+        let output = format!(
+            "{}\n{newest}\nOr run codex resume and select a session.\n",
+            commands.join("\n")
+        );
+        assert_eq!(latest_command(&output), Some(newest.as_str()));
+    }
+}
+
+#[test]
+fn command_names_and_session_ids_are_complete_tokens() {
+    for prefix in ["codex resume ", "claude --resume "] {
+        for output in [
+            format!("not{prefix}{CODEX_SESSION}"),
+            format!("{prefix}{CODEX_SESSION}/extra"),
+            format!("{prefix}{CODEX_SESSION}.invalid"),
+        ] {
+            assert_eq!(latest_command(&output), None, "{output}");
+        }
+    }
+}
+
+#[test]
+fn quoted_commands_and_crlf_keep_valid_session_ids() {
+    for prefix in ["codex resume ", "claude --resume "] {
+        let expected = format!("{prefix}{CODEX_SESSION}");
+        for output in [
+            format!("Run `{expected}`, then continue."),
+            format!("  {expected}\r\n$ "),
+        ] {
+            assert_eq!(latest_command(&output), Some(expected.as_str()));
+        }
+    }
+}
