+  video.querySelectorAll("track").forEach((subtitleElement) => subtitleElement.remove());
+  const subtitleGeneration = (video.__subtitleGeneration || 0) + 1;
+  video.__subtitleGeneration = subtitleGeneration;
+  if (!subtitleTracks.length) return;
+  video.addEventListener("loadedmetadata", () => {
+    if (video.__subtitleGeneration !== subtitleGeneration) return;
